# WhatsApp Bridge - Environment Configuration

# Server
PORT=5057
NODE_ENV=development

# WhatsApp / Baileys
WHATSAPP_SESSION_PATH=./auth_info_baileys

# AI Providers (add only the ones you use)
MOONSHOT_API_KEY=your_moonshot_key_here
GEMINI_API_KEY=your_gemini_key_here
NVIDIA_NIM_API_KEY=your_nvidia_key_here
OLLAMA_API_KEY=your_ollama_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
GROQ_API_KEY=your_groq_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
HUGGINGFACE_API_KEY=your_huggingface_key_here
KIMI_API_KEY=your_kimi_key_here

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Database
DATABASE_PATH=./conversations.db

# Flask Services (if running separately)
JARVIS_AGI_URL=http://localhost:5052
FLASK_HANDLER_URL=http://localhost:5056
